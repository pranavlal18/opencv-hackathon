%% SeaRescue Agent — actual implemented architecture (Task 12).
%% NOTE: only implemented components are shown. The Mermaid CLI renderer
%% is not installed on the authoring machine, so this source is committed
%% unrendered; paste into https://mermaid.live to view.
flowchart TD
    subgraph LOCAL["Local workstation (Windows 11, CPU-only, Python 3.12)"]
        IMG["Maritime image\n(SeaDronesSee val sample)"] --> Q["OpenCV 5 quality signals\nLaplacian variance (sharpness)\nbrightness / contrast (960x540 proxy)"]
        IMG --> D["Detector: YOLOv8n (ultralytics 8.4.177, CPU)\ncoarse pass at 640 px, floor 0.10"]
        D --> POOL["Observation pool conf >= 0.15\n{class, conf, rel_area} + quality + state + budget"]
        Q --> POOL
        POOL --> VAL["validate_request()\nschema + range + forbidden-key guard"]
        VAL --> OBS["measurement-only request\n(never a pre-selected decision)"]
        OBS --> SIG["SigV4 signing (stdlib only)\ncredentials via AWS CLI provider,\nnever printed or stored"]
    end

    subgraph AWS["AWS (ap-south-1, stack searescue-agent)"]
        URL["Lambda Function URL\nAuthType AWS_IAM (403 for unsigned)"]
        URL --> FN["Lambda: python3.12, 256 MB, 10 s\nimports the SAME decision_service module"]
        FN --> DECIDE["validate + deterministic decision\nkeep_sparse_sampling | sample_densely |\ncrop_zoom | request_human_review\n+ reason + trace_id (sha256[:16])"]
    end

    SIG -->|"HTTPS POST (signed)"| URL
    DECIDE --> RESP["action + args + reason\n+ budget_remaining"]

    subgraph EXEC["Local action execution + evidence"]
        RESP --> EX1["keep_sparse_sampling -> keep initial detections\nsample_densely -> one 960 px full-frame pass\nrequest_human_review -> review flag + banner"]
        RESP --> EX2["crop_zoom -> match target to local box\n(context-expanded crop, 1.5x)"]
        EX2 --> ZOOM["Detector re-inference on crop @960\nswimmer-only filter, budget <= 2 enforced"]
        ZOOM --> MAP["map_to_frame + pixel clamp\nper-class NMS merge (IoU 0.5)"]
    end

    MAP --> EV["Evidence artifacts:\nbefore/after annotated JPGs,\nfinal_detections.json,\ndemo_traces.jsonl (request, endpoint truth,\ntrace_id parity, timings; secrets never recorded)"]
    EX1 --> EV
    FN -.->|"platform logs (JSON, 30-day retention)"| CW["CloudWatch log group\n/aws/lambda/searescue-agent-DecideFunction"]
